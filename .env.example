# ==========================================================================
# Pulse Artwork Studio AI — environment template
# Copy to `.env` and fill real values. NEVER commit the real .env.
# ==========================================================================

# ---- General ----
ENVIRONMENT=local            # local | staging | production
DEBUG=true

# ---- API ----
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ---- Auth / security ----
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-a-32-byte-random-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- PostgreSQL ----
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse
POSTGRES_HOST=postgres        # 'localhost' when running the API outside docker
POSTGRES_PORT=5432
# Assembled URL (async driver). Overrides the parts above if set directly.
DATABASE_URL=postgresql+asyncpg://pulse:pulse@postgres:5432/pulse

# ---- Redis (broker + cache) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Object storage (S3-compatible; MinIO in local dev) ----
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # what the browser can reach
S3_ACCESS_KEY=pulse-minio
S3_SECRET_KEY=pulse-minio-secret
S3_REGION=us-east-1
S3_BUCKET_ORIGINALS=pulse-originals
S3_BUCKET_DERIVED=pulse-derived
S3_BUCKET_EXPORTS=pulse-exports
S3_SIGNED_URL_TTL_SECONDS=900

# ---- Uploads ----
MAX_UPLOAD_MB=100
ALLOWED_UPLOAD_MIME=image/png,image/jpeg,image/webp

# ---- AI providers (SERVER-SIDE ONLY — never expose to the Flutter client) ----
# AI_PROVIDER=stub
# AI_PROVIDER_API_KEY=
